# Required. A long random password; it is the only login.
APP_PASSWORD=change-me-to-a-long-random-string

# Optional. Public URL of the app, used for the button in the daily email.
APP_URL=http://localhost:3000

# Email: pick ONE provider, or leave both empty to write emails to ./outbox
# Resend (free tier): https://resend.com/api-keys
RESEND_API_KEY=
# The free tier sender below only delivers to the address that owns the Resend account.
MAIL_FROM=Cadence <onboarding@resend.dev>
# SMTP (for example Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional
PORT=3000
DATA_DIR=data
OUTBOX_DIR=outbox
# SESSION_SECRET=      # defaults to APP_PASSWORD
# TRUST_PROXY=true     # only behind your own reverse proxy
# FAKE_NOW=            # demo and tests only, e.g. 2026-10-26T03:30:00Z
