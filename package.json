{
  "name": "dayfold-study-planner",
  "version": "1.0.0",
  "description": "Self-hosted study planner: exam countdowns, a time-blocked daily plan and a morning email.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "seed:demo": "tsx scripts/seed.ts demo",
    "seed:personal": "tsx scripts/seed.ts personal",
    "screenshots": "tsx scripts/screenshots.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "scan": "tsx scripts/scan.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tanstack/query-sync-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
